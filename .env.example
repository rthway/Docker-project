# Copy to .env and set real values before running any stack here.
#   cp .env.example .env
#
# .env is gitignored. These are LOCAL LEARNING STACKS -- none of them are
# hardened for exposure beyond localhost.

# --- Nextcloud stack --------------------------------------------------------
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGE-ME
NEXTCLOUD_DB_ROOT_PASSWORD=CHANGE-ME
NEXTCLOUD_PORT=8080

# --- WordPress stack --------------------------------------------------------
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=CHANGE-ME
WORDPRESS_DB_ROOT_PASSWORD=CHANGE-ME
WORDPRESS_PORT=8080

# --- Django exercise --------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
